# Server Port (used by standalone backend server)
PORT=5000

# SMTP Server Configuration
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-16-char-app-password (generated from Google Account > Security > App Passwords)
#
# For Hostinger / Custom cPanel:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=contact@yourdomain.com
#   SMTP_PASS=your-mailbox-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Destination email where contact form submissions will be delivered
CONTACT_RECEIVER_EMAIL=pavan.dsgn@gmail.com

# Display name for outgoing mail
SMTP_FROM_NAME="Portfolio Contact Form"
